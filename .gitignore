# Dependencies — restored by `bun install` at the workspace root.
node_modules/

# Build output. `web/` is SSR: the server bundle is generated by `bun run build`.
dist/

# Astro's generated types and local cache. `web/tsconfig.json` includes
# `.astro/types.d.ts` by path, but it is generated, not authored: `astro sync`
# writes it, and `astro dev` / `astro build` run sync first — so a fresh clone
# has it back before anything reads it. The directory also holds dev-server
# scratch (a PID, a port, a console log) that is specific to one machine.
.astro/

# Tracker state never lives in the checkout: EARWITNESS_STATE defaults to
# ~/.local/share/earwitness/, deliberately outside it. This is the guard for
# anyone who points EARWITNESS_STATE here anyway — a day of plays is not
# source, and plays.json is rewritten ~400 times a day.
plays.json
plays.json.*.bak
live.flag

# Atomic-write temp files: `writeState` writes .plays.json.<pid>.<n>.tmp beside
# the target, then renames. A crash mid-write leaves one behind.
.plays.json.*.tmp

# Frame captures from the README's ffmpeg toolkit, run by hand from the repo
# root. Root-anchored on purpose: a bare `*.png` would silently swallow a real
# asset dropped into `web/public/`. `sample.ts` is an MPEG transport stream,
# not TypeScript — same reason it is pinned to the root and not matched loosely.
/tick.png
/tick_*.png
/t_*.png
/frame.png
/sample.ts

# macOS
.DS_Store
