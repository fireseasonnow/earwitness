---
import "../styles/global.css";
import { REFRESH_SECONDS } from "../lib/freshness";
import { absolute, CARD, SITE_NAME } from "../lib/metadata";

interface Props {
  title: string;
  /** The unfurl and the search result. Words: `lib/metadata.ts`. */
  description: string;
  /** Reload every tick so new plays appear live. Cadence: `lib/freshness.ts`. */
  autoRefresh?: boolean;
}
const { title, description, autoRefresh = false } = Astro.props;

// The path and not the URL: `?utm_…` and `?via=…` arrivals are one page, and the
// edge is already told to ignore the query in its cache key.
const canonical = absolute(Astro.url.pathname);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {autoRefresh && <meta http-equiv="refresh" content={String(REFRESH_SECONDS)} />}
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Absolute, and built from `ORIGIN` rather than the request: this is also
        what tells a crawler that `www` and the apex are one page. */}
    <link rel="canonical" href={canonical} />

    {/* The unfurl. X reads the `og:*` pair when no `twitter:*` twin is there;
        the card type is the one tag it will not infer. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(CARD.path)} />
    <meta property="og:image:width" content={String(CARD.width)} />
    <meta property="og:image:height" content={String(CARD.height)} />
    <meta property="og:image:alt" content={CARD.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The Pixel Note again — same 21 blocks as the header mark, one drawing
        served four ways. The SVG is for browsers; an image crawler wants a
        square raster, and `/favicon.ico` is requested by path whatever the
        markup declares.

        96px is a multiple of the 48 a crawler asks for and an exact 4x of the
        drawing's 24px grid, so `crispEdges` lands blocks on pixel boundaries.
        The touch icon is opaque: iOS composites a transparent one onto BLACK.

        The .ico carries 48 AND 96 because the tab strip wants ~16-32 and the
        grid is 12 blocks across: only a multiple of 12 divides into whole
        pixels, so 48 is the smallest honest entry to downscale from.

        Rendered from the SVG by `bun run icons`, never by hand — a blank
        raster is a valid PNG, and one shipped. See scripts/render-icons.ts.

        The crawler's PNG is `icon-96.png`, not the `favicon-96.png` it replaces:
        Google's favicon cache is keyed by URL, so correcting the bytes under a
        path it had already fetched changed nothing it would ever look at. It is
        also opaque now — a transparent one gets composited onto a background of
        Google's choosing, and that is one more thing to be wrong. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48 96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Roboto Mono, Apache-2.0. The `--font-mono` token puts the
        platform monospace stack behind it, so a blocked CDN costs the page its
        face and nothing else: every size and tracking value still applies. */}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;700&display=swap"
    />

    {/* The one literal colour outside the theme: a meta value cannot reference
        a CSS custom property. It is `--color-paper`, and moves with it. */}
    <meta name="theme-color" content="#f5f3ed" />
  </head>
  <body class="min-h-screen bg-paper font-mono text-ink antialiased">
    <slot />
  </body>
</html>
