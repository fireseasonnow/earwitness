---
import type { Hero } from "../lib/presentation";
import { toneText } from "../lib/presentation";

/**
 * The health surface and the now-playing surface, in one place.
 *
 * Four slots, filled in every state. The reserved minimum height and
 * `justify-end` are what keep the log below from moving as the state changes
 * between 30-second refreshes.
 */
interface Props {
  hero: Hero;
}
const { hero } = Astro.props;
---

<div class="flex min-h-[168px] flex-col justify-end md:min-h-[186px] lg:min-h-[196px]">
  <div
    class:list={[
      "mb-[16px] text-label font-medium uppercase tracking-label md:mb-[18px] md:text-note lg:mb-[20px]",
      toneText[hero.tone],
    ]}
  >
    {hero.kicker}
  </div>

  {/* Absent, not blank — an empty artist must not leave a gap or a separator. */}
  {
    hero.artist !== null && (
      <div class="mb-[7px] text-lede text-artist-ink md:mb-[8px] md:text-lede-md lg:text-lede-lg">
        {hero.artist}
      </div>
    )
  }

  {/* An h2 despite being the biggest type on the page: it says a different
      thing on every render, and the document's top heading has to be what the
      page IS. The wordmark in `DayView.astro` carries that. */}
  <h2
    class="text-hero font-medium leading-[1.2] tracking-title text-pretty md:text-hero-md lg:text-hero-lg"
  >
    {hero.headline}
  </h2>

  <p class="mt-[14px] text-row leading-[1.55] text-muted md:mt-[15px] lg:mt-[16px]">
    {hero.detail}
  </p>
</div>
