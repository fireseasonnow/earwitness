---
/**
 * The Pixel Note — the product mark.
 *
 * An eighth note on a 12x12 grid: 21 blocks, each 2 units square on even
 * coordinates. The page header and the favicon are the same geometry, so there
 * is no separate small-size cut.
 *
 * `currentColor` is the point: the mark inherits the health tone from whatever
 * contains it, so "the mark goes grey off air" is one CSS property on the
 * parent rather than a colour threaded through six states.
 *
 * `crispEdges` keeps the blocks hard-edged at sizes where a 2-unit block does
 * not divide into whole pixels — every size that is not a multiple of 12.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  shape-rendering="crispEdges"
  aria-hidden="true"
  class:list={["shrink-0", className]}
>
  <rect x="4" y="14" width="2" height="2" />
  <rect x="6" y="14" width="2" height="2" />
  <rect x="8" y="14" width="2" height="2" />
  <rect x="10" y="14" width="2" height="2" />
  <rect x="4" y="16" width="2" height="2" />
  <rect x="6" y="16" width="2" height="2" />
  <rect x="8" y="16" width="2" height="2" />
  <rect x="10" y="16" width="2" height="2" />
  <rect x="4" y="18" width="2" height="2" />
  <rect x="6" y="18" width="2" height="2" />
  <rect x="8" y="18" width="2" height="2" />
  <rect x="10" y="18" width="2" height="2" />
  <rect x="12" y="12" width="2" height="2" />
  <rect x="12" y="14" width="2" height="2" />
  <rect x="12" y="4" width="2" height="2" />
  <rect x="12" y="6" width="2" height="2" />
  <rect x="12" y="8" width="2" height="2" />
  <rect x="12" y="10" width="2" height="2" />
  <rect x="14" y="4" width="2" height="2" />
  <rect x="16" y="4" width="2" height="2" />
  <rect x="16" y="6" width="2" height="2" />
</svg>
